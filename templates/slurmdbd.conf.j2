##
## This file is maintained by Ansible - ALL MODIFICATIONS WILL BE REVERTED
##

# Authentication information
AuthType=auth/munge

# Daemon configuration
DbdHost={{ inventory_hostname }}
DbdPort={{ slurm_dbd_port }}
DebugLevel=info
LogFile={{ slurm_install_dir }}/log/slurmdbd.log
PidFile=/var/run/slurmdbd/slurmdbd.pid
SlurmUser={{ slurm_user }}

# Archive settings
ArchiveEvents=yes
ArchiveJobs=yes
ArchiveSteps=no
ArchiveSuspend=no
ArchiveResvs=no
ArchiveTXN=no
ArchiveUsage=no
PurgeEventAfter=1month
PurgeJobAfter=12month
PurgeResvAfter=1month
PurgeStepAfter=1month
PurgeSuspendAfter=1month
PurgeTXNAfter=12month
PurgeUsageAfter=24month

# Database connection information
StorageType=accounting_storage/mysql
StorageHost=localhost
StoragePort=3306
StorageUser={{ slurm_db_user }}
StoragePass={{ slurm_db_pass }}
StorageLoc={{ slurm_db_name }}
